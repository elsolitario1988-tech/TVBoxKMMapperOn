<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/md_theme_dark_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:marginBottom="16dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/title_main"
                style="@style/TextStyle.Title" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSettings"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="⚙️"
                android:textSize="18sp"
                app:cornerRadius="8dp"
                style="@style/Widget.App.Button" />

        </LinearLayout>

        <!-- Dispositivos conectados -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_dim"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/label_connected_devices"
                    style="@style/TextStyle.Subtitle"
                    android:layout_marginBottom="12dp" />

                <!-- Estado Teclado -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">

                    <ImageView
                        android:id="@+id/iconKeyboard"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/label_keyboard"
                        android:tint="@color/accent_blue"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_keyboard"
                        style="@style/TextStyle.Body" />

                    <TextView
                        android:id="@+id/tvKeyboardStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/status_disconnected"
                        style="@style/TextStyle.Body" />

                </LinearLayout>

                <!-- Estado Mouse -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/iconMouse"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:contentDescription="@string/label_mouse"
                        android:tint="@color/accent_green"
                        android:layout_marginEnd="12dp" />

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_mouse"
                        style="@style/TextStyle.Body" />

                    <TextView
                        android:id="@+id/tvMouseStatus"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/status_disconnected"
                        android:textColor="@color/status_disconnected"
                        style="@style/TextStyle.Body" />

                </LinearLayout>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Monitor de entrada en tiempo real -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="@color/surface_dim"
            app:cardCornerRadius="12dp"
            app:cardElevation="8dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Monitor de Entrada"
                    style="@style/TextStyle.Subtitle"
                    android:layout_marginBottom="12dp" />

                <!-- Última tecla -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_last_key_pressed"
                        style="@style/TextStyle.Body" />

                    <TextView
                        android:id="@+id/tvLastKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/accent_blue"
                        style="@style/TextStyle.Body"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Posición mouse -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_mouse_position"
                        style="@style/TextStyle.Body" />

                    <TextView
                        android:id="@+id/tvMousePos"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="X: 0, Y: 0"
                        android:textColor="@color/accent_green"
                        style="@style/TextStyle.Body"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Botón mouse -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="12dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/label_mouse_button"
                        style="@style/TextStyle.Body" />

                    <TextView
                        android:id="@+id/tvMouseButton"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="—"
                        android:textColor="@color/accent_yellow"
                        style="@style/TextStyle.Body"
                        android:textStyle="bold" />

                </LinearLayout>

                <!-- Log de eventos -->
                <ScrollView
                    android:layout_width="match_parent"
                    android:layout_height="0dp"
                    android:layout_weight="1"
                    android:layout_marginTop="8dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvEventLog"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Registro de eventos..."
                            style="@style/TextStyle.Caption"
                            android:textIsSelectable="true"
                            android:textColor="@color/md_theme_dark_on_surface_variant" />

                    </LinearLayout>

                </ScrollView>

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>

        <!-- Botones de control -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:spacing="8dp">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStartMonitoring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start_monitoring"
                app:cornerRadius="8dp"
                style="@style/Widget.App.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnStopMonitoring"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_stop_monitoring"
                app:cornerRadius="8dp"
                style="@style/Widget.App.Button" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnClearLog"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_clear_log"
                app:cornerRadius="8dp"
                style="@style/Widget.App.OutlinedButton" />

        </LinearLayout>

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
